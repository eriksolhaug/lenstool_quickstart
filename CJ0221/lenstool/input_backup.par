runmode                
	reference     3 178.33025102933408 7.93251817558377 # reference coordinates in sexagesimal=1, degrees=3
	arclet        1 arcs/1153arc_v2_zvary.dat
	inverse       3 0.5 200 # int1=0, no optimization. int1=1, parabolic optimization (float1=max number of optimizations). int1=2, Monte Carlo. int1=3, Bayesian optimization method (float1=speed of convergence, float2=number of iterations for burn-in phase).
	sigposArcsec  0.2
	sigpos        0.1
	verbose       1
	end
image
	multfile      1 arcs/1153arc_v2_zvary.dat #>0=read 
	forme         -1 # <0 image plane chi2. >=0 source plane chi2.
	mult_wcs      3
	sigposArcsec  0.2
	z_m_limit     1 A3a A4a 1 1.3 1.7 0.001
	z_m_limit     1 B7a 1 1.7 2.1 0.001
	critic        1 -11.968 11.630 135.876 0.18645 1.524
	end
grille
	nombre        128 # Number of points of the grid used to invert lens equation
	polaire       0 # grid radial (polar)=1, rectangular=0
	nlentille     48 # Number of clumps making up the lensing potential. If greater than number of potentials, then this is effectively set to the number of potentials.
	nlens_crit    6 # Number of clumps for which critical lines must be calculated. Only used for SNAKE algorithm in cline, algorithm
	nlens_opt     6 # Number of clumps that will be optimized
	end
# Main dark matter halo around BCG
potentiel O1
	profil       81
	x_centre     -0.209451
	y_centre     -0.486841
	ellipticite     0.497312
	angle_pos       120.447123
	core_radius_kpc     50.005799
	cut_radius_kpc     1500.000000
	v_disp     881.265938
	z_lens     0.4301
	end
limit 1
	x_centre           1 -2.0 6.0 0.010
	y_centre           1 -8.0 3.0 0.010
	ellipticite        1  0.0 0.6 0.001
	angle_pos          1  0. 180.0 0.100
	core_radius_kpc    1  5.0 150.0 0.10
	v_disp             1  800. 1200. 0.10 
	end
# Subhalo near COOLJ1153B images 1 and 2
potentiel O2
	profil       81
	x_centre     4.693000
	y_centre     -18.695000
	ellipticite     0.000000
	angle_pos       0.000000
	core_radius_kpc     0.744869
	cut_radius_kpc     25.000000
	v_disp     122.049574
	z_lens     0.4301
	end
limit 2
	ellipticite        1  0.0 0.6 0.001
	angle_pos          1  0. 180.0 0.100
	core_radius_kpc    1  0.1 50.0 0.05
	cut_radius_kpc     1  3.0 100.0 0.05
	v_disp             1  5. 250. 0.05
	end
# z=~0.5 galaxy between COOLJ1153A images 2 and 3
potentiel O3
	profil       81
	x_centre     -0.516000
	y_centre     14.783000
	ellipticite     0.255039
	angle_pos       134.000000
	core_radius_kpc     11.654820
	cut_radius_kpc     25.000000
	v_disp     178.764822
	z_lens     0.4301
	end
limit 3
	ellipticite        1  0.0 0.6 0.001
	angle_pos          0  0. 180.0 0.100
	core_radius_kpc    1  0.1 50.0 0.05
	cut_radius_kpc     1  3.0 100.0 0.05
	v_disp             1  5. 250. 0.05
	end
# Foreground galaxy between COOLJ1153A image 1 and 2, close to the lensed red early type galaxy
potentiel O4
	profil       81
	x_centre     -10.089000
	y_centre     12.483000
	ellipticite     0.000000
	angle_pos       0.000000
	core_radius_kpc     4.478919
	cut_radius_kpc     25.000000
	v_disp     155.902850
	z_lens     0.4301
	end
limit 4
	ellipticite        1  0.0 0.6 0.001
	angle_pos          0  0. 180.0 0.100
	core_radius_kpc    1  0.1 50.0 0.05
	cut_radius_kpc     1  3.0 100.0 0.05
	v_disp             1  5. 250. 0.05
	end
# Foreground galaxy near COOLJ1153A image 2
potentiel O5
	profil       81
	x_centre     -5.659000
	y_centre     15.838000
	ellipticite     0.261810
	angle_pos       0.000000
	core_radius_kpc     4.425410
	cut_radius_kpc     25.000000
	v_disp     216.856755
	z_lens     0.4301
	end
limit 5
	ellipticite        1  0.0 0.6 0.001
	angle_pos          1  0. 180.0 0.100
	core_radius_kpc    1  0.1 50.0 0.05
	cut_radius_kpc     1  3.0 100.0 0.05
	v_disp             1  5. 250. 0.05
	end
# Potential of line-of-sight cluster at z=0.5766
potentiel O6
	profil       81
	x_centre     180.000000
	y_centre     -80.000000
	ellipticite     0.000000
	angle_pos       0.000000
	core_radius_kpc     0.000000
	cut_radius_kpc     1500.000000
	v_disp     600.000000
	z_lens     0.4301
	end
limit 6
	v_disp             1  500. 800. 0.10 
	end
potfile0
	filein  3 cats/1153ground.cat
	zlens   0.4301
	type    81
	corekpc 0.150000
	mag0    19.530000
	sigma   1 115.415843 84.590184
	cutkpc  1 3. 100.
	slope   0 4.000000 0.000000
	vdslope 0 4.000000 0.000000
	vdscatter 0 0.000000 0.000000
	rcutscatter 0 0.000000 0.000000
	end
cline
	nplan         2 1.524 1.939 # Two background sources - blue and red quasar
	dmax          30.000
	algorithm     MARCHINGSQUARES
	limitHigh     5.0
	limitLow      0.25
	end
grande
	iso           0 0 0.000 0.000 0.000
	name          best
	profil        0 0
	contour       1 0
	large_dist    0.300
	end
cosmologie # Using same cosmology as in the rest of Solhaug et al. 2025
	H0            70.000
	omegaM        0.300
	omegaX        0.700
	wX           -1.000
	end
champ
	xmin         -30.00
	xmax         30.00
	ymin         -30.00
	ymax          30.00
	end
fini
